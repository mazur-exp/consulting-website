node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz

# Секреты. Ключи для замера AI Visibility лежат в .secrets/aivis.env —
# в репозитории по пути, но НИКОГДА не в git. Не убирать эти строки.
.secrets/
*.env
.env
.env.*

# Серверный лог трафика (см. server/crawler-log.ts)
logs/

# sitemap.xml генерируется из git-дат при каждой сборке (scripts/sitemap.mjs —
# первый шаг npm run build). Держать его ещё и в репозитории значит, что на
# сервере после сборки рабочая копия всегда грязная и следующий git pull
# отказывается мержить. Источник правды — генератор, не файл.
client/public/sitemap.xml
